{
  "schema_version": 1,
  "settings": {
    "date_format": "MM-DD-YYYY"
  },
  "taxonomies": {
    "doc_types": [
      "Search warrant return",
      "Subpoena return",
      "Court order",
      "Supplemental report",
      "Forensic report"
    ]
  },
  "fields": {
    "identifier": {
      "label": "Case number",
      "type": "text",
      "required": true,
      "normalize": ["trim", "upper", "dashes"],
      "formats": [
        { "pattern": "##-YYYY-######" },
        { "pattern": "SOYYMMDD-######" }
      ],
      "from_filename": true
    },
    "doc_type": {
      "label": "Document type",
      "type": "choice",
      "taxonomy": "doc_types",
      "required": true
    },
    "doc_title": {
      "label": "Document title",
      "type": "text",
      "required": false
    },
    "received": {
      "label": "Date received",
      "type": "date",
      "required": false
    }
  },
  "profiles": [
    {
      "name": "Records submission",
      "default": true,
      "fields": ["identifier", "doc_type", "doc_title", "received"],
      "stamps": [
        {
          "text": "{identifier}  |  {doc_type}  |  Page {page} of {total}"
        }
      ],
      "output_name": {
        "fields": ["identifier", "doc_type"],
        "separator": "_",
        "include_original_name": true
      },
      "metadata": {
        "CaseNumber": "{identifier}"
      }
    }
  ]
}
