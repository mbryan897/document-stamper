# Normalize text line endings; never touch binary documents.
* text=auto
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.in text eol=lf
*.lock text eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
# Font licenses are checked byte for byte against SOURCE.txt (fetch_font.ps1, build.ps1):
# never convert their line endings.
assets/fonts/*.txt -text
*.otf binary
