{
  "schema_version": 1,
  "settings": {
    "date_format": "MM-DD-YYYY"
  },
  "taxonomies": {
    "doc_types": [
      "Report",
      "Return",
      "Order",
      "Correspondence",
      "Other"
    ]
  },
  "fields": {
    "identifier": {
      "label": "Identifier",
      "type": "text",
      "required": true,
      "normalize": [
        "trim",
        "upper",
        "dashes"
      ],
      "formats": [
        {
          "name": null,
          "pattern": "*",
          "regex": null
        }
      ],
      "taxonomy": null,
      "from_filename": true
    },
    "doc_type": {
      "label": "Document type",
      "type": "choice",
      "required": false,
      "normalize": [
        "trim"
      ],
      "formats": [],
      "taxonomy": "doc_types",
      "from_filename": false
    },
    "doc_title": {
      "label": "Document title",
      "type": "text",
      "required": false,
      "normalize": [
        "trim"
      ],
      "formats": [],
      "taxonomy": null,
      "from_filename": false
    },
    "new_field": {
      "label": "date",
      "type": "date",
      "required": false,
      "normalize": [
        "trim"
      ],
      "formats": [],
      "taxonomy": null,
      "from_filename": false
    }
  },
  "profiles": [
    {
      "name": "Standard",
      "default": true,
      "fields": [
        "identifier",
        "doc_type",
        "doc_title"
      ],
      "stamps": [
        {
          "text": "{identifier}  |  Page {page} of {total}",
          "anchor": "top-right",
          "direction": "along-top",
          "margin_in": 0.25,
          "font_size_pt": 9.0,
          "color": "#2B3A8F",
          "background_box": true,
          "pages": "all"
        }
      ],
      "output_name": {
        "fields": [
          "identifier",
          "doc_type"
        ],
        "separator": "_",
        "include_original_name": true
      },
      "metadata": {
        "Identifier": "{identifier}"
      }
    }
  ]
}
