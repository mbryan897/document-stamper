# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Packaging metadata from editable installs
*.egg-info/
.eggs/

# Virtual environments
.venv/
.venv-build/
venv/
env/

# PyInstaller output (keep .spec files under packaging/)
build/
dist/

# IDE and editor folders
.vscode/
.idea/
*.code-workspace
*.swp

# Windows clutter
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Generated test corpus (rebuilt by tools/make_corpus.py)
tests/corpus/generated/

# Local scratch output while developing
out/
*.stamped.pdf

# Never commit local config overrides or last-used values
config/local*.json
# config.json next to the app: from source that is the repo root (D-080)
/config.json
/config.json.bak
# dated backups kept by Profile settings (config.json.20261115-011538.bak)
/config.json.*.bak

# Local screenshots and notes from GUI work (never committed)
docs-local/

# Local AI agent tool state (never committed)
.claude-flow/
.swarm/
.venv-icon/
